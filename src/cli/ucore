                    technique,
                    "--preset",
                    args.preset,
                ]
                if args.skip_dataset_eval:
                    train_cmd.append("--allow-ungated-dataset")
                if args.full_merge_export:
                    train_cmd.append("--full-merge-export")
                else:
                    train_cmd.append("--export-gguf")
                if args.wandb:
                    train_cmd.append("--wandb")
                os.environ["WORKFLOW_NEXT_ACTION"] = "export_adapter"
                os.environ["WORKFLOW_NEXT_ARTIFACT"] = str(export_dir)
                train_env = {"WANDB_JOB_TYPE": "train", "WORKFLOW_HOOKS_PATH": pipeline_hooks}
                run_cmd(train_cmd, extra_env=train_env)

            ggufs = list(export_dir.glob("*.gguf")) if export_dir.exists() else []
            if ggufs:
                ggufs.sort(key=lambda x: x.stat().st_mtime, reverse=True)

            print("[STAGE] export")
            if not args.skip_smoke:
                with trace_type("agent", name="Phase 5: Smoke Testing"):
                    print("\n--- Phase 5: Smoke Testing ---")
                    if ggufs:
                        smoke_cmd = [
                            PYTHON,
                            str(SCRIPTS_DIR / "ops" / "smoke_test.py"),
                            str(ggufs[0]),
                            "--spec",
                            args.spec,
                        ]
                        if args.track:
                            smoke_cmd.append("--track")
                        os.environ["WORKFLOW_NEXT_ACTION"] = "evaluate_pipeline"
                        os.environ["WORKFLOW_NEXT_ARTIFACT"] = str(ggufs[0])
                        run_cmd(smoke_cmd, extra_env={"WORKFLOW_HOOKS_PATH": pipeline_hooks})
                    else:
                        print("Warning: No GGUF found for smoke testing")

            if not args.skip_eval:
                with trace_type("agent", name="Phase 6: Evaluation"):
                    print("\n--- Phase 6: Evaluation ---")
                    # Re-scan for GGUFs if not already found
                    if not ggufs and export_dir.exists():
                        ggufs = sorted(
                            export_dir.glob("*.gguf"), key=lambda x: x.stat().st_mtime, reverse=True
                        )
                    if len(ggufs) >= 2:
                        # Candidate = newest GGUF (just exported), Baseline = previous export
                        candidate_path = ggufs[0]
                        baseline_path = ggufs[1]
                        print(f"  Candidate (new): {candidate_path.name}")
                        print(f"  Baseline (prev): {baseline_path.name}")
                        print("  Running side-by-side evaluation...")
                        eval_cmd = [
                            PYTHON,
                            str(SCRIPTS_DIR / "evaluation" / "evaluate.py"),
                            "--baseline",
                            str(baseline_path),
                            "--candidate",
                            str(candidate_path),
                            "--spec",
                            args.spec,
                            "--num-questions",
                            str(args.num_eval_questions),
                            "--track",
                        ]
                        if args.eval_judge:
                            eval_cmd.append("--judge")
                            if args.eval_judge_provider != "ollama":
                                eval_cmd.extend(["--judge-provider", args.eval_judge_provider])
                            if args.eval_judge_model:
                                eval_cmd.extend(["--judge-model", args.eval_judge_model])
                            if args.wandb_inference_project:
                                eval_cmd.extend(
                                    ["--wandb-inference-project", args.wandb_inference_project]
                                )
                            if args.wandb_inference_entity:
                                eval_cmd.extend(
                                    ["--wandb-inference-entity", args.wandb_inference_entity]
                                )
                        if args.wandb:
                            eval_cmd.append("--wandb")
                        os.environ["WORKFLOW_NEXT_ACTION"] = "NONE"
                        os.environ.pop("WORKFLOW_NEXT_ARTIFACT", None)
                        run_cmd(
                            eval_cmd,
                            extra_env={
                                "WANDB_JOB_TYPE": "eval",
                                "WORKFLOW_HOOKS_PATH": pipeline_hooks,
                            },
                        )
                    elif len(ggufs) == 1:
                        print(
                            f"  Only one GGUF export found ({ggufs[0].name}) — no baseline to compare against."
                        )
                        print(
                            "  Run pipeline again after a future training to get a side-by-side evaluation."
                        )
                    else:
                        print("  Warning: No GGUF found — skipping evaluation")

        # Clean up workflow env vars to avoid polluting subsequent commands
        for var in [
            "WORKFLOW_ID",
            "WORKFLOW_NEXT_ACTION",
            "WORKFLOW_NEXT_ARTIFACT",
            "WORKFLOW_AWAIT_CONFIRMATION",
        ]:
            os.environ.pop(var, None)

        print("[STAGE] complete")
        print("\n--- Pipeline Complete! ---")

    elif args.command == "plan-execution":
        cmd = [
            PYTHON,
            str(SCRIPTS_DIR / "orchestration" / "plan_execution.py"),
            "--spec",
            args.spec,
        ]
        if args.preset:
            cmd.extend(["--preset", args.preset])
        if args.local_vram_gb is not None:
            cmd.extend(["--local-vram-gb", str(args.local_vram_gb)])
        if args.json:
            cmd.append("--json")
        run_cmd(cmd)

    elif args.command == "history":
        from src.core.ops.pipeline_db import PipelineDB

        db = PipelineDB()
        if not db.ensure_connected():
            print("Error: PipelineDB not connected", file=sys.stderr)
            return 1

        if args.history_command == "wins":
            rows = db.query_eval_sessions(npc_key=args.npc_key, limit=args.limit)
            if args.json:
                print(_json_serialize(rows))
            else:
                if not rows:
                    print(f"No eval sessions found{' for ' + args.npc_key if args.npc_key else ''}")
                else:
                    print(
                        f"{'npc_key':<22} {'comparison_id':<35} {'baseline':<22} {'candidate':<22} {'win_rate':>8} {'judge':<20}"
                    )
                    print("-" * 130)
                    for r in rows:
                        wr = r.get("win_rate", "?")
                        if wr is not None:
                            wr = f"{float(wr) * 100:>6.0f}%"
                        else:
                            wr = "   N/A"
                        print(
                            f"{r.get('npc_key', '?'):<22} "
                            f"{(r.get('comparison_id') or '(no id)'):<35} "
                            f"{(r.get('baseline_model') or '?'):<22} "
                            f"{(r.get('candidate_model') or '?'):<22} "
                            f"{wr:>8} "
                            f"{(r.get('judge_model') or '?'):<20}"
                        )

        elif args.history_command == "quality":
            rows = db.query_quality_gates(npc_key=args.npc_key, limit=args.limit)
            if args.json:
                print(_json_serialize(rows))
            else:
                if not rows:
                    print(f"No quality gates found{' for ' + args.npc_key if args.npc_key else ''}")
                else:
                    print(
                        f"{'npc_key':<22} {'pass_rate':>10} {'pass_count':>6} {'/total':>6}  {'judge':<30}"
                    )
                    print("-" * 76)
                    for r in rows:
                        pr = r.get("pass_rate", "?")
                        if pr is not None:
                            pr = f"{float(pr) * 100:>6.0f}%"
                        print(
                            f"{r.get('npc_key', '?'):<22} "
                            f"{pr:>10} "
                            f"{r.get('pass_count', 0):>6} "
                            f"/{str(r.get('total_examples', 0)):>4}  "
                            f"{(r.get('judge_model') or '?'):<30}"
                        )

        elif args.history_command == "metrics":
            rows = db.get_metrics(run_id=args.run_id, limit=args.limit)
            if args.json:
                print(_json_serialize(rows))
            else:
                if not rows:
                    print(f"No metrics found for run {args.run_id}")
                else:
                    for m in rows:
                        print(
                            f"  step={m['step']:>5}  loss={m.get('loss', '?'):>8}  "
                            f"lr={m.get('learning_rate', '?'):>10}  "
                            f"tokens/s={m.get('tokens_per_second', '?'):>8}"
                        )

        db.close()

    elif args.command == "backup":
        from src.core.ops.backup_cleanup import PROJECT_ROOT as BACKUP_PROJECT_ROOT
        from src.core.ops.backup_cleanup import run_cleanup

        result = run_cleanup(BACKUP_PROJECT_ROOT, retain=args.retain, dry_run=args.dry_run)
        if args.json:
            print(_json_serialize(result))
        else:
            print(
                f"\nBackup cleanup: {result['moved']} moved, {result['pruned']} pruned, {result['errors']} errors"
            )
            for p, c in sorted(result.get("by_pattern", {}).items()):
                print(f"  {p}: {c}")

    elif args.command == "registry":
        from src.core.ops.pipeline_db import PipelineDB

        db = PipelineDB()
        if not db.ensure_connected():
            print("Error: PipelineDB not connected", file=sys.stderr)
            return 1

        if args.registry_command == "models":
            rows = db.get_model_registry(npc_key=args.npc_key)
            if args.json:
                print(_json_serialize(rows))
            else:
                if not rows:
                    print(f"No registered models for NPC '{args.npc_key}'")
                else:
                    for r in rows:
                        print(
                            f"  {r.get('model_name'):<40} {r.get('base_model'):<20} "
                            f"{r.get('technique'):<8} [{r.get('status', '?')}] "
                            f"tags={r.get('tags', [])}"
                        )

        elif args.registry_command == "datasets":
            rows = db.query_datasets(npc_key=args.npc_key, limit=20)
            if args.json:
                print(_json_serialize(rows))
            else:
                if not rows:
                    print(f"No dataset versions for NPC '{args.npc_key}'")
                else:
                    for r in rows:
                        print(
                            f"  v{r.get('version', '?'):<8} "
                            f"hash={r.get('content_hash', '?'):<20} "
                            f"technique={r.get('technique', '?'):<10} "
                            f"rows={r.get('row_count', '?'):>6} "
                            f"size={r.get('size_bytes', '?'):>8}"
                        )

        elif args.registry_command == "register-model":
            result = db.create_model_registry(
                npc_key=args.npc_key,
                model_name=args.model_name,
                base_model=args.base_model,
                technique=args.technique,
                tags=args.tags or [],
                status=args.status,
            )
            if result:
                print(
                    f"Registered model '{args.model_name}' for NPC '{args.npc_key}' (id={result['id'][:12]}...)"
                )
            else:
                print("Error: Failed to register model", file=sys.stderr)
                return 1

        db.close()

    else:
        parser.print_help()
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

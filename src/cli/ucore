    reg_register.add_argument("--tags", nargs="*", help="Tags (e.g. candidate production)")
    reg_register.add_argument("--status", default="draft", help="Status (default: draft)")

    return parser


def main(argv: list[str] | None = None) -> int:
    """Entry point: build parser, parse args, dispatch."""
    parser = create_parser()
    args = parser.parse_args(argv)

    if args.workflow_hooks:
        os.environ["WORKFLOW_HOOKS_PATH"] = args.workflow_hooks
    if args.watch:
        os.environ["UCORE_WATCH"] = "1"

    if args.command in ["init", "new-npc"]:
        cmd = [PYTHON, str(SCRIPTS_DIR / "ops" / "scaffold_npc.py"), args.npc_key]
        if args.subject is not None: cmd.extend(["--subject", args.subject])
        if args.name is not None: cmd.extend(["--name", args.name])
        if args.force: cmd.append("--force")
        if args.skip_spec: cmd.append("--skip-spec")
        run_cmd(cmd)
        return 0

    if args.command == "new-npc-checklist":
        payload = _new_npc_checklist_payload(args.npc_key, args.subject, args.name)
        if args.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        else:
            print(f"New NPC checklist for {args.npc_key}")
            if args.name:
                print(f"Name: {args.name}")
            if args.subject:
                print(f"Subject: {args.subject}")
            for step in payload["steps"]:
                print(f"- {step}")
            print("JSON issue policy:")
            print("- avoid a bunch of loose JSON files")
            print("- use .pipeline/runs/<run_id>/artifacts.json as the canonical run record")
            print("- archive legacy scattered outputs")
        return 0

    if args.command == "new-npc-bootstrap":
        cmd = [PYTHON, str(SCRIPTS_DIR / "ops" / "scaffold_npc.py"), args.npc_key]
        if args.subject is not None:
            cmd.extend(["--subject", args.subject])
        if args.name is not None:
            cmd.extend(["--name", args.name])
        if args.force:
            cmd.append("--force")
        if args.skip_spec:
            cmd.append("--skip-spec")
        if args.json:
            result = subprocess.run(cmd, cwd=PROJECT_ROOT, check=True, capture_output=True, text=True)
        else:
            run_cmd(cmd)
            result = None
        payload = _new_npc_checklist_payload(args.npc_key, args.subject, args.name)
        if args.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        else:
            print(f"Bootstrapped NPC: {args.npc_key}")
            if args.print_plan:
                print("Recommended next steps:")
                for step in payload["steps"]:
                    print(f"- {step}")
            print("Canonical JSON policy:")
            print("- use .pipeline/runs/<run_id>/artifacts.json")
            print("- avoid ad hoc JSON scatter for decisions")
        return 0

    if args.command == "target":
        from src.core.orchestration.target_runner import TargetRunner

        runner = TargetRunner(artifact_index=args.artifact_index if hasattr(args, 'artifact_index') else None)

        if args.target_command == "plan":
            plan = runner.plan(
                npc_key=args.npc_key,
                profile=args.profile if hasattr(args, 'profile') else "npc-production-grounded",
                technique=args.technique,
                target_stage=args.target_stage,
            )
            if args.json if hasattr(args, 'json') else False:
                print(_json_serialize(plan))
            else:
                print(f"Target plan: npc={args.npc_key} target={args.target_stage} technique={args.technique or '-'}")
                print(f"  ready: {plan.get('ready')}  profile: {plan.get('profile', '-')}")
                if plan.get('blockers'):
                    for b in plan['blockers']:
                        print(f"  blocker: {b}")
                if plan.get('cache_hits'):
                    print(f"  cached: {', '.join(plan['cache_hits'].keys())}")
                print(f"{'stage':<14} {'status':<12} {'action':<6} {'reason':<26} {'missing'}")
                print("-" * 88)
                for step in plan["steps"]:
                    missing = ",".join(step.get("missing_inputs") or []) or "-"
                    print(
                        f"{step['stage']:<14} {step['status']:<12} {step['action']:<6} "
                        f"{step['reason']:<26} {missing}"
                    )
            return 0

        if args.target_command == "run":
            plan = runner.plan(
                npc_key=args.npc_key,
                profile=args.profile if hasattr(args, 'profile') else "npc-production-grounded",
                technique=args.technique,
                target_stage=args.target_stage,
            )

            # For dry-run, just show commands
            dry_run = args.dry_run if hasattr(args, 'dry_run') else False

            if dry_run:
                cmds = runner.dry_run(plan)
                if not cmds:
                    print("✓ All stages cached. Nothing to do.")
                    return 0
                print(f"Target dry-run: npc={args.npc_key} target={args.target_stage}")
                for cmd in cmds:
                    display = " ".join(str(c) for c in cmd["command"])
                    print(f"  [{cmd['stage']}] {cmd['reason']}: {display}")
                return 0

            # Real execution
            print(f"Target run: npc={args.npc_key} target={args.target_stage} resume={args.resume or False}")
            results = runner.run(
                plan,
                dry_run=False,
                resume=args.resume if hasattr(args, 'resume') else False,
                force_stage=args.force_stage if hasattr(args, 'force_stage') else None,
            )

            # Report results
            failed = [r for r in results if r.get("exit_code", 0) != 0]
            if failed:
                for r in failed:
                    print(f"  [FAIL] {r['stage']} (exit {r.get('exit_code')})")
                return 1
            print(f"  ✓ All stages completed ({len(results)} steps)")
            return 0

        return 0


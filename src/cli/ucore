EARLY_ALERT_PATTERNS = [
    re.compile(r"Traceback \(most recent call last\):"),
    re.compile(
        r"\b(?:AssertionError|ModuleNotFoundError|RuntimeError|ValueError|KeyError|IndexError|CalledProcessError|OSError)\b"
    ),
    re.compile(r"\b(?:ERROR|Error:|FAILED|FAILURE)\b"),
    re.compile(r"Command timed out|timed out after"),
    re.compile(r"^\s*F\s+🎯 Evaluating test case"),
]


def _should_watch() -> bool:
    return os.getenv("UCORE_WATCH", "").strip() == "1"


def _make_watch_dir() -> Path:
    base = Path(os.getenv("UCORE_WATCH_DIR") or (Path(tempfile.gettempdir()) / "ucore-watch"))
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    watch_dir = base / f"{stamp}-{os.getpid()}"
    watch_dir.mkdir(parents=True, exist_ok=True)
    return watch_dir


def _line_is_early_alert(line: str) -> bool:
    return any(pattern.search(line) for pattern in EARLY_ALERT_PATTERNS)


def _write_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(payload, indent=2, ensure_ascii=False, default=str) + "\n", encoding="utf-8"
    )


def _json_serialize(obj: object) -> str:
    """JSON stringify with datetime support, for CLI --json output."""
    return json.dumps(obj, indent=2, ensure_ascii=False, default=str)


def build_pipeline_sanitize_cmd(
    dataset_path: Path | str,
    output_path: Path | str,
    *,
    allow_metadata_repair: bool = False,
) -> list[str]:
    """Build the sanitize command used by the full pipeline.

    Production/default pipeline runs require generator-complete metadata.
    ``allow_metadata_repair`` is a dev-only escape hatch for template smoke runs.
    """
    cmd = [
        PYTHON,
        str(SCRIPTS_DIR / "dataset" / "sanitize_dataset.py"),
        str(dataset_path),
        "--output",
        str(output_path),
        "--strict-canonical",
    ]
    if not allow_metadata_repair:
        cmd.append("--require-complete-metadata")
    return cmd


def run_cmd(cmd, cwd=PROJECT_ROOT, announce=True, extra_env=None):
    """Run a shell command and print its output.

    Args:
        cmd: Command list to execute.
        cwd: Working directory.
        announce: Whether to print the command before running.
        extra_env: Optional dict of extra environment variables merged into the current env.
    """
    if announce:
        print(f"Running: {' '.join(cmd)}", flush=True)
    env = os.environ.copy()
    existing_pythonpath = env.get("PYTHONPATH")
    repo_pythonpath = str(PROJECT_ROOT)
    env["PYTHONPATH"] = (
        f"{repo_pythonpath}{os.pathsep}{existing_pythonpath}"
        if existing_pythonpath
        else repo_pythonpath
    )
    if extra_env:
        env.update(extra_env)

    if not _should_watch():
        try:
            subprocess.run(cmd, cwd=str(cwd), check=True, env=env)
        except subprocess.CalledProcessError as e:
            if announce:
                print(f"Error: Command failed with return code {e.returncode}")
            sys.exit(e.returncode)
        return

    watch_dir = _make_watch_dir()
    log_path = watch_dir / "stream.log"
    alerts_path = watch_dir / "alerts.jsonl"
    summary_path = watch_dir / "summary.json"
    print(f"[WATCH] streaming logs to {watch_dir}", flush=True)

    proc = subprocess.Popen(
        cmd,
        cwd=str(cwd),
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
    )
    alerts: list[dict[str, str]] = []
    started_at = datetime.now().isoformat()
    try:
        assert proc.stdout is not None
        with (
            log_path.open("a", encoding="utf-8") as log_file,
            alerts_path.open("a", encoding="utf-8") as alert_file,
        ):
            while True:
                line = proc.stdout.readline()
                if line == "" and proc.poll() is not None:
                    break
                if not line:
                    continue
                sys.stdout.write(line)
                sys.stdout.flush()
                log_file.write(line)
                log_file.flush()
                if _line_is_early_alert(line):
                    alert = {
                        "timestamp": datetime.now().isoformat(),
                        "line": line.rstrip("\n"),
                        "command": " ".join(cmd),
                    }
                    alerts.append(alert)
                    alert_file.write(json.dumps(alert, ensure_ascii=False) + "\n")
                    alert_file.flush()
                    print(f"[WATCH][ALERT] {line.rstrip()}", flush=True)
            returncode = proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        try:
            returncode = proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            proc.kill()
            returncode = proc.wait()
        print("[WATCH] interrupted; process terminated", flush=True)

    summary = {
        "started_at": started_at,
        "finished_at": datetime.now().isoformat(),
        "returncode": returncode,
        "command": cmd,
        "watch_dir": str(watch_dir),
        "alerts": alerts,
    }
    _write_json(summary_path, summary)
    if returncode != 0:
        print(
            f"[WATCH] Command failed with return code {returncode}. Logs: {watch_dir}", flush=True
        )
        sys.exit(returncode)


def _new_npc_checklist_payload(
    npc_key: str, subject: str | None = None, name: str | None = None
) -> dict:
    return {
        "npc_key": npc_key,
        "name": name,
        "subject": subject,
        "steps": [
            "1. validate-spec",
            "2. compare-local-models if you need to choose a default local model",
            "3. generate",
            "4. sanitize",
            "5. dataset-eval",
            "6. fix shared pipeline issues if the gate fails",
            "7. train only after the gate passes",
            "8. evaluate and compare-canonical-runs",
            "9. export",
        ],
        "json_issue_policy": {
            "problem": "avoid a bunch of loose JSON files",
            "rule": "treat .pipeline/runs/<run_id>/artifacts.json as the canonical run record and archive legacy scattered outputs",
            "notes": [
                "Use compare-local-models for model selection.",
                "Use compare-canonical-runs for run comparison.",
                "Keep stage outputs for compatibility, but rely on canonical artifacts for decisions.",
            ],
        },
    }



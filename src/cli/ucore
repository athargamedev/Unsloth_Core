    target_run = target_sub.add_parser("run", help="Execute (or preview) a target plan")
    target_run.add_argument("--npc-key", required=True, help="NPC key to run")
    target_run.add_argument("--technique", default=None, help="Dataset technique/artifact lane")
    target_run.add_argument(
        "--target-stage",
        default="evaluate",
        choices=["generate", "sanitize", "dataset_eval", "train", "export", "evaluate"],
        help="Stage to run up to",
    )
    target_run.add_argument(
        "--profile", default="npc-production-grounded", help="NPC profile label"
    )
    target_run.add_argument(
        "--dry-run", action="store_true", help="Preview commands without executing"
    )
    target_run.add_argument("--resume", action="store_true", help="Skip already-completed stages")
    target_run.add_argument("--force-stage", default=None, help="Force re-run a specific stage")
    target_run.add_argument(
        "--artifact-index", default=None, help="ArtifactRegistry JSONL path override"
    )

    # Judge cache
    judge_cache_p = subparsers.add_parser(
        "judge-cache", help="Inspect durable LLM judge-result cache"
    )
    judge_cache_sub = judge_cache_p.add_subparsers(
        dest="judge_cache_command", help="Judge cache subcommand", required=True
    )
    judge_cache_stats = judge_cache_sub.add_parser("stats", help="Show judge cache stats")
    judge_cache_stats.add_argument(
        "--db-path", default=None, help="Judge cache SQLite path override"
    )
    judge_cache_stats.add_argument("--json", action="store_true", help="Output JSON")

    # Report bundle
    report_p = subparsers.add_parser("report", help="Pipeline report bundle operations")
    report_sub = report_p.add_subparsers(
        dest="report_command", help="Report subcommand", required=True
    )
    report_bundle = report_sub.add_parser("bundle", help="Build pipeline report bundle")
    report_bundle.add_argument("--npc-key", required=True, help="NPC key")
    report_bundle.add_argument("--technique", default=None, help="Dataset technique")
    report_bundle.add_argument(
        "--target-stage",
        default="evaluate",
        choices=["generate", "sanitize", "dataset_eval", "train", "export", "evaluate"],
        help="Target stage",
    )
    report_bundle.add_argument(
        "--profile", default="npc-production-grounded", help="Strategy profile"
    )
    report_bundle.add_argument(
        "--report-dir", default=None, help="Override report output directory"
    )

    # Inference server
    infer_p = subparsers.add_parser("inference-server", help="Local Ollama inference control plane")
    infer_sub = infer_p.add_subparsers(
        dest="inference_command", help="Inference server subcommand", required=True
    )

    def _add_infer_common(p):
        p.add_argument("--ollama-host", default="http://localhost:11434", help="Ollama host URL")
        p.add_argument("--model", default=None, help="Model override")
        p.add_argument("--timeout", type=int, default=180, help="Request timeout seconds")

    infer_serve = infer_sub.add_parser("serve", help="Serve /status /warm /judge /unload")
    infer_serve.add_argument("--host", default="127.0.0.1", help="Bind host")
    infer_serve.add_argument("--port", type=int, default=8765, help="Bind port")
    _add_infer_common(infer_serve)

    infer_status = infer_sub.add_parser("status", help="Print backend/model status as JSON")
    _add_infer_common(infer_status)

    infer_warm = infer_sub.add_parser("warm", help="Warm selected model")
    _add_infer_common(infer_warm)
    infer_warm.add_argument("--keep-alive", default="30m", help="Ollama keep_alive duration")
    infer_warm.add_argument("--prompt", default="ping", help="Tiny warmup prompt")

    infer_judge = infer_sub.add_parser("judge", help="Run one JSON judge call")
    _add_infer_common(infer_judge)
    infer_judge.add_argument("--input", required=True, help="User/input text")
    infer_judge.add_argument("--actual-output", required=True, help="Model output to judge")
    infer_judge.add_argument(
        "--context", action="append", default=[], help="Reference context chunk"
    )

    infer_unload = infer_sub.add_parser(
        "unload", help="Unload selected model or all running Ollama models"
    )
    _add_infer_common(infer_unload)

    # ── History (experiment dashboard) ──────────────────────────────
    hist_p = subparsers.add_parser(
        "history",
        help="Query experiment history: win rates, quality trends, training metrics",
    )
    hist_sub = hist_p.add_subparsers(
        dest="history_command", help="History subcommand", required=True
    )

    hist_wins = hist_sub.add_parser("wins", help="Win-rate trends for comparison runs")
    hist_wins.add_argument("--npc-key", help="Filter by NPC key")
    hist_wins.add_argument("--limit", type=int, default=10, help="Max results (default: 10)")
    hist_wins.add_argument("--json", action="store_true", help="Output JSON")

    hist_quality = hist_sub.add_parser("quality", help="Quality gate score trends")
    hist_quality.add_argument("--npc-key", help="Filter by NPC key")
    hist_quality.add_argument("--limit", type=int, default=20, help="Max results (default: 20)")
    hist_quality.add_argument("--json", action="store_true", help="Output JSON")

    hist_metrics = hist_sub.add_parser("metrics", help="Training step metrics for a run")
    hist_metrics.add_argument("--run-id", required=True, help="Run ID to query")
    hist_metrics.add_argument("--limit", type=int, default=50, help="Max metric rows (default: 50)")
    hist_metrics.add_argument("--json", action="store_true", help="Output JSON")

    hist_backup = hist_sub.add_parser(
        "backup",
        help="Move .pre_* backup debris to .pipeline/backups/ with retention",
    )
    hist_backup.add_argument(
        "--retain", type=int, default=10, help="Max backups per pattern (default: 10)"
    )
    hist_backup.add_argument("--dry-run", action="store_true", help="Preview without moving")

    # ── Registry (model + dataset catalog) ──────────────────────────
    reg_p = subparsers.add_parser(
        "registry",
        help="Manage model registry and dataset version catalog",
    )
    reg_sub = reg_p.add_subparsers(
        dest="registry_command", help="Registry subcommand", required=True
    )

    reg_models = reg_sub.add_parser("models", help="List registered models for an NPC")
    reg_models.add_argument("--npc-key", required=True, help="NPC key")
    reg_models.add_argument("--json", action="store_true", help="Output JSON")

    reg_datasets = reg_sub.add_parser("datasets", help="List dataset versions for an NPC")
    reg_datasets.add_argument("--npc-key", required=True, help="NPC key")
    reg_datasets.add_argument("--json", action="store_true", help="Output JSON")

    reg_register = reg_sub.add_parser("register-model", help="Register a trained model")
    reg_register.add_argument("--npc-key", required=True, help="NPC key")
    reg_register.add_argument("--model-name", required=True, help="Model display name")
    reg_register.add_argument("--base-model", required=True, help="Base model (e.g. qwen2.5:7b)")
    reg_register.add_argument(
        "--technique",
        required=True,
        choices=["lora", "qlora", "full", "grpo"],
        help="Training technique",
    )
    reg_register.add_argument("--tags", nargs="*", help="Tags (e.g. candidate production)")
    reg_register.add_argument("--status", default="draft", help="Status (default: draft)")

    return parser


def main(argv: list[str] | None = None) -> int:
    """Entry point: build parser, parse args, dispatch."""
    parser = create_parser()
    args = parser.parse_args(argv)

    if args.workflow_hooks:
        os.environ["WORKFLOW_HOOKS_PATH"] = args.workflow_hooks
    if args.watch:
        os.environ["UCORE_WATCH"] = "1"

    if args.command == "preflight":
        cmd = [PYTHON, str(SCRIPTS_DIR / "ops" / "preflight.py"), "--phase", args.phase]
        if args.preset:
            cmd.extend(["--preset", args.preset])
        if args.spec:
            cmd.extend(["--spec", args.spec])
        if args.technique:
            cmd.extend(["--technique", args.technique])
        if args.ollama_url != "http://localhost:11434":
            cmd.extend(["--ollama-url", args.ollama_url])
        if args.no_auto_unload_ollama:
            cmd.append("--no-auto-unload-ollama")
        if args.no_gcc_check:
            cmd.append("--no-gcc-check")
        if args.no_lease:
            cmd.append("--no-lease")
        if args.json:
            cmd.append("--json")
        if args.check_modal:
            cmd.append("--check-modal")
        run_cmd(cmd, announce=not args.json)
        return 0

    if args.command == "new-npc-checklist":
        payload = _new_npc_checklist_payload(args.npc_key, args.subject, args.name)
        if args.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
        else:
            print(f"New NPC checklist for {args.npc_key}")
            if args.name:
                print(f"Name: {args.name}")
            if args.subject:
                print(f"Subject: {args.subject}")
            for step in payload["steps"]:
                print(f"- {step}")
            print("JSON issue policy:")
            print("- avoid a bunch of loose JSON files")
            print("- use .pipeline/runs/<run_id>/artifacts.json as the canonical run record")
            print("- archive legacy scattered outputs")
        return 0

    if args.command == "target":
        from src.core.orchestration.target_runner import TargetRunner

        runner = TargetRunner(
            artifact_index=args.artifact_index if hasattr(args, "artifact_index") else None
        )

        if args.target_command == "plan":
            plan = runner.plan(
                npc_key=args.npc_key,
                profile=args.profile if hasattr(args, "profile") else "npc-production-grounded",
                technique=args.technique,
                target_stage=args.target_stage,
            )
            plan["dry_run_commands"] = runner.dry_run(plan)
            if args.json if hasattr(args, "json") else False:
                print(_json_serialize(plan))
            else:
                print(
                    f"Target plan: npc={args.npc_key} target={args.target_stage} technique={args.technique or '-'}"
                )
                print(f"  ready: {plan.get('ready')}  profile: {plan.get('profile', '-')}")
                if plan.get("blockers"):
                    for b in plan["blockers"]:
                        print(f"  blocker: {b}")
                if plan.get("cache_hits"):
                    print(f"  cached: {', '.join(plan['cache_hits'].keys())}")
                print(f"{'stage':<14} {'status':<12} {'action':<6} {'reason':<26} {'missing'}")
                print("-" * 88)
                for step in plan["steps"]:
                    missing = ",".join(step.get("missing_inputs") or []) or "-"
                    print(
                        f"{step['stage']:<14} {step['status']:<12} {step['action']:<6} "
                        f"{step['reason']:<26} {missing}"
                    )
            return 0

        if args.target_command == "run":
            plan = runner.plan(
                npc_key=args.npc_key,
                profile=args.profile if hasattr(args, "profile") else "npc-production-grounded",
                technique=args.technique,
                target_stage=args.target_stage,
            )

            # For dry-run, just show commands
            dry_run = args.dry_run if hasattr(args, "dry_run") else False

            if dry_run:
                cmds = runner.dry_run(plan)
                if not cmds:
                    print("✓ All stages cached. Nothing to do.")
                    return 0
                print(f"Target dry-run: npc={args.npc_key} target={args.target_stage}")
                for cmd in cmds:
                    display = " ".join(str(c) for c in cmd["command"])
                    print(f"  [{cmd['stage']}] {cmd['reason']}: {display}")
                return 0

            # Real execution
            print(
                f"Target run: npc={args.npc_key} target={args.target_stage} resume={args.resume or False}"
            )
            results = runner.run(
                plan,
                dry_run=False,
                resume=args.resume if hasattr(args, "resume") else False,
                force_stage=args.force_stage if hasattr(args, "force_stage") else None,
            )

            # Report results
            failed = [r for r in results if r.get("exit_code", 0) != 0]
            if failed:
                for r in failed:
                    print(f"  [FAIL] {r['stage']} (exit {r.get('exit_code')})")
                return 1
            print(f"  ✓ All stages completed ({len(results)} steps)")
            return 0

        return 0

    if args.command == "judge-cache":
        from src.core.ops.judge_cache import JudgeCache

        cache = JudgeCache(args.db_path)
        stats = cache.stats()
        if args.json:
            print(_json_serialize(stats))
        else:
            print("Judge cache")
            print(f"  db_path: {stats['db_path']}")
            print(f"  entries: {stats['entries']}")
            print(f"  total_hits: {stats['total_hits']}")
            if stats["by_judge"]:
                print("  by_judge:")
                for judge, count in stats["by_judge"].items():
                    print(f"    {judge}: {count}")
        return 0

    if args.command == "report":
        if args.report_command == "bundle":
            from src.core.reports.pipeline_bundle import build_pipeline_bundle

            result = build_pipeline_bundle(
                npc_key=args.npc_key,
                profile=args.profile,
                technique=args.technique,
                target_stage=args.target_stage,
                report_dir=args.report_dir if hasattr(args, "report_dir") else None,
            )
            report_dir = result.get("report_dir", "?")
            summary = result.get("summary", "")
            print(f"Report bundle built for {result['npc_key']} ({result['target_stage']})")
            print(f"  Report dir: {report_dir}")
            print(
                f"  Integration health: {'OK' if result.get('integration_audit', {}).get('ok') else 'BLOCKERS'}"
            )
            print(f"  Summary: {summary[:120]}...")
            print("  Files written:")
            for fname in [
                "pipeline_run_spec.json",
                "stage_status.json",
                "integration_health.json",
                "dataset_quality.json",
                "runtime_eval_report.json",
                "training_report.json",
                "summary.md",
                "index.html",
                "next_actions.json",
            ]:
                fp = Path(report_dir) / fname
                exists = "✓" if fp.exists() else "✗"
                print(f"    {exists} {fname}")
            return 0

    if args.command == "inference-server":
        cmd = [PYTHON, str(SCRIPTS_DIR / "ops" / "inference_server.py"), args.inference_command]
        if args.inference_command == "serve":
            cmd.extend(["--host", args.host, "--port", str(args.port)])
        cmd.extend(["--ollama-host", args.ollama_host])
        if args.model:
            cmd.extend(["--model", args.model])
        if args.timeout != 180:
            cmd.extend(["--timeout", str(args.timeout)])
        if args.inference_command == "warm":
            cmd.extend(["--keep-alive", args.keep_alive, "--prompt", args.prompt])
        elif args.inference_command == "judge":
            cmd.extend(["--input", args.input, "--actual-output", args.actual_output])
            for context in args.context:
                cmd.extend(["--context", context])
        run_cmd(cmd)
        return 0

    if args.command == "audit":
        if args.audit_command == "pipeline-plan":
            from src.core.orchestration.target_runner import TargetRunner

            runner = TargetRunner(artifact_index=args.artifact_index)
            plan = runner.plan(
                npc_key=args.npc_key,
                profile="npc-production-grounded",
                technique=args.technique,
                target_stage=args.target_stage,
            )
            if args.write:
                out = Path(args.write)
                _write_json(out, plan)
                print(f"Pipeline plan written: {out}")
            else:
                print(json.dumps(plan, indent=2, ensure_ascii=False, default=str))
            return 0

        if args.audit_command == "config-coherence":
            from src.core.ops.config_coherence import audit_config_coherence, format_audit_table

            result = audit_config_coherence(PROJECT_ROOT)
            if args.json:
                print(json.dumps(result, indent=2, ensure_ascii=False))
            else:
                print(format_audit_table(result))
            return 0 if result["ok"] else 1

        if args.audit_command == "integrations":
            from src.core.ops.integration_audit import (
                audit_integrations,
                format_integration_audit,
            )

            result = audit_integrations(profile=args.profile, root=PROJECT_ROOT)
            if args.json:
                print(json.dumps(result, indent=2, ensure_ascii=False))
            else:
                print(format_integration_audit(result))
            return 0

        if args.audit_command == "context":
            cmd = [PYTHON, str(SCRIPTS_DIR / "ops" / "context_audit.py")]
            cmd.extend(args.paths or [])
            if args.json:
                cmd.append("--json")
            if args.instructions_audit:
                cmd.append("--instructions-audit")
            run_cmd(cmd, announce=not args.json)
            return 0

        if args.audit_command == "docker-core":
            cmd = [PYTHON, str(SCRIPTS_DIR / "ops" / "docker_core_status.py")]
            if args.watchdog:
                cmd.append("--watchdog")
            run_cmd(cmd)
            return 0

        from src.core.ops.audit import ProjectAudit

        audit = ProjectAudit()
        if args.audit_command == "check":
            audit.report("full" if args.full else "env")
        elif args.audit_command == "diagnose":
            audit.diagnose_npc(args.npc)
        elif args.audit_command == "resume":
            audit.report("full")
        else:
            audit.report("env")
        return 0

    if args.command == "generate":
        cmd = [PYTHON, str(SCRIPTS_DIR / "dataset" / "_generate_shared.py"), args.spec]
        technique = "ollama" if args.ollama else args.technique
        cmd.extend(["--technique", technique])
        if technique == "ollama":
            cmd.append("--ollama")
        if args.docs_manifest:
            cmd.extend(["--docs-manifest", args.docs_manifest])
        if args.model:
            cmd.extend(["--model", args.model])
        if args.concept_focus:
            for cf in args.concept_focus:
                cmd.extend(["--concept-focus", cf])
        if args.fresh:
            cmd.append("--fresh")
        run_cmd(cmd)

    elif args.command == "generate-ollama":
        cmd = [PYTHON, str(SCRIPTS_DIR / "dataset" / "generate_dataset.py"), args.spec]
        if args.model:
            cmd.extend(["--model", args.model])
        if args.url and args.url != "http://localhost:11434":
            cmd.extend(["--url", args.url])
        if args.inference_server_url:
            cmd.extend(["--inference-server-url", args.inference_server_url])
        if args.batch_size != 4:
            cmd.extend(["--batch-size", str(args.batch_size)])
        if args.max_retries != 3:
            cmd.extend(["--max-retries", str(args.max_retries)])
        if args.temperature != 0.6:
            cmd.extend(["--temperature", str(args.temperature)])
        if args.multi_turn_ratio != 0.25:
            cmd.extend(["--multi-turn-ratio", str(args.multi_turn_ratio)])
        if args.seed != 42:
            cmd.extend(["--seed", str(args.seed)])
        if args.output:
            cmd.extend(["--output", args.output])
        if args.concept_focus:
            for cf in args.concept_focus:
                cmd.extend(["--concept-focus", cf])
        if args.fresh:
            cmd.append("--fresh")
        if args.no_validation:
            cmd.append("--no-validation")
        if args.val_split != 0.12:
            cmd.extend(["--val-split", str(args.val_split)])
        if args.check_health:
            cmd.append("--check-health")
        if args.pull_model:
            cmd.append("--pull-model")
        if args.dry_run:
            cmd.append("--dry-run")
        run_cmd(cmd)

    elif args.command == "generate-local":
        import signal
        import time

        model_path = os.path.abspath(args.model)
        if not os.path.isfile(model_path):
            print(f"Error: model not found: {model_path}", file=sys.stderr)
            sys.exit(1)

        # 1. Start llama.cpp server via llama-servers.sh
        port = args.port
        scripts = os.path.expanduser("~/llama-servers.sh")
        if not os.path.isfile(scripts):
            print("Error: ~/llama-servers.sh not found", file=sys.stderr)
            sys.exit(1)

        print(f"Starting llama.cpp server on :{port} ...")
        ret = subprocess.run(
            ["bash", scripts, "serve", model_path, str(port)], capture_output=True, text=True
        )
        print(ret.stdout)
        if ret.returncode != 0:
            print(ret.stderr, file=sys.stderr)
            sys.exit(1)

        # 2. Run generation against local server
        url = f"http://127.0.0.1:{port}/v1/chat/completions"
        gen_cmd = [
            PYTHON,
            str(SCRIPTS_DIR / "dataset" / "generate_dataset.py"),
            args.spec,
            "--url",
            url,
            "--model",
            os.path.basename(model_path),
        ]
        if args.temperature != 0.6:
            gen_cmd.extend(["--temperature", str(args.temperature)])
        if args.batch_size != 4:
            gen_cmd.extend(["--batch-size", str(args.batch_size)])
        if args.max_retries != 3:
            gen_cmd.extend(["--max-retries", str(args.max_retries)])
        if args.seed != 42:
            gen_cmd.extend(["--seed", str(args.seed)])
        if args.output:
            gen_cmd.extend(["--output", args.output])
        if args.fresh:
            gen_cmd.append("--fresh")
        if args.no_validation:
            gen_cmd.append("--no-validation")
        if args.val_split != 0.12:
            gen_cmd.extend(["--val-split", str(args.val_split)])
        if args.multi_turn_ratio != 0.25:
            gen_cmd.extend(["--multi-turn-ratio", str(args.multi_turn_ratio)])
        if args.concept_focus:
            for cf in args.concept_focus:
                gen_cmd.extend(["--concept-focus", cf])

        print(f"Generating against llama.cpp at {url} ...")
        gen_ret = subprocess.run(gen_cmd)
        gen_ok = gen_ret.returncode == 0

        # 3. Stop the server
        server_pid = None
        try:
            out = subprocess.check_output(
                f"pgrep -f 'llama-server.*port {port}'",
                shell=True,
                executable="/usr/bin/bash",
                text=True,
            ).strip()
            if out:
                server_pid = out.splitlines()[0]
                os.kill(int(server_pid), signal.SIGTERM)
                # Wait up to 5s
                for _ in range(5):
                    try:
                        os.kill(int(server_pid), 0)
                        time.sleep(1)
                    except ProcessLookupError:
                        break
                else:
                    os.kill(int(server_pid), signal.SIGKILL)
                print(f"Stopped llama.cpp server (PID {server_pid})")
        except Exception:
            pass

        if not gen_ok:
            sys.exit(gen_ret.returncode)

    elif args.command == "sanitize":
        cmd = [PYTHON, str(SCRIPTS_DIR / "dataset" / "sanitize_dataset.py"), args.input]
        if args.output:
            cmd.extend(["--output", args.output])
        if args.min_length != 10:
            cmd.extend(["--min-length", str(args.min_length)])
        if args.max_sentences != 5:
            cmd.extend(["--max-sentences", str(args.max_sentences)])
        if args.verbose:
            cmd.append("--verbose")
        if args.spec:
            cmd.extend(["--spec", args.spec])
        if args.strict_canonical:
            cmd.append("--strict-canonical")
        if args.strict_mode:
            cmd.append("--strict-mode")
        if args.artifact_check != "strict":
            cmd.extend(["--artifact-check", args.artifact_check])
        if args.verbose_artifacts:
            cmd.append("--verbose-artifacts")
        if args.quality_threshold_pass != 70:
            cmd.extend(["--quality-threshold-pass", str(args.quality_threshold_pass)])
        if args.quality_threshold_flag != 50:
            cmd.extend(["--quality-threshold-flag", str(args.quality_threshold_flag)])
        if args.quality_report:
            cmd.append("--quality-report")
        if args.llm_check:
            cmd.append("--llm-check")
        if args.llm_model:
            cmd.extend(["--llm-model", args.llm_model])
        if args.judge_cache_path:
            cmd.extend(["--judge-cache-path", args.judge_cache_path])
        if args.no_judge_cache:
            cmd.append("--no-judge-cache")
        if args.inference_server_url:

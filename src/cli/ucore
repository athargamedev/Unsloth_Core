    gen_ollama_p.add_argument("--pull-model", action="store_true", help="Auto-pull model if not found")
    gen_ollama_p.add_argument("--fresh", action="store_true",
                        help="Ignore checkpoint recovery and regenerate the dataset from scratch")
    gen_ollama_p.add_argument("--concept-focus", action="append", dest="concept_focus",

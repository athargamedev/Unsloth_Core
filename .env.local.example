# DeepEval / Confident AI runtime configuration
# Copy this file to .env.local and fill in the values.

# Confident AI API key for trace uploads and remote evaluation results.
# If omitted, DeepEval runs locally and traces are not uploaded.
CONFIDENT_API_KEY="your_confident_api_key_here"

# Optional: override the DeepEval judge endpoint.
# Set this when you are running Ollama locally or via a remote dev instance.
DEEPEVAL_LIVE_MODEL_URL="http://localhost:11434"
DEEPEVAL_OLLAMA_BASE_URL="http://localhost:11434"
DEEPEVAL_OLLAMA_MODEL="qwen2.5:7b"
DEEPEVAL_OLLAMA_TEMPERATURE="0"

# Optional: version tag for prompt telemetry and trace metadata.
DEEPEVAL_PROMPT_VERSION="2026-06-01"

# Enable flush-on-exit for Confident AI trace uploads.
CONFIDENT_TRACE_FLUSH="1"

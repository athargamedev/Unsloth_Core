[pytest]
pythonpath = .
cache_dir = var/.cache/pytest
markers =
    unit: pure unit tests
    contract: path, CLI, schema, and naming invariant tests
    integration: touches real workflow command boundaries
    slow: slow tests
    requires_ollama: needs Ollama server or model
    requires_gpu: needs CUDA GPU
    requires_llama_cpp: needs llama.cpp binaries
    requires_supabase: needs local Supabase
    requires_wandb: needs W&B credentials or network
    live_model: loads a model or starts a model server
    smoke_template_only: template generation is allowed only for smoke tests
    production_path: production workflow behavior

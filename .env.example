# ── Unsloth_Core Environment Variables ──────────────────────────────────────
# Copy this file to .env (for the project-wide .env) or .env.local
# (for env_loader.py) and fill in your credentials.
#
# Canonical reference: etc/env-reference.yaml
# Platform configs:    etc/<platform>/config.yaml
#
# REQUIRED vars (no pipeline runs without them):
#   WANDB_API_KEY, CONFIDENT_API_KEY, HF_TOKEN (if using gated models)
#
# OPTIONAL vars: everything else — tune behavior, not required.

# ── W&B ── Experiment Tracking + Serverless Inference Judge ────────────────
# Required for: W&B logging, W&B Inference judge (production profile)
# Config file:  etc/wandb/config.yaml
# Settings:     etc/wandb/settings (entity + project, loaded via WANDB_CONFIG_DIR)
WANDB_API_KEY=""
WANDB_CONFIG_DIR=etc/wandb

# ── Confident AI / DeepEval ── Eval Orchestration + Trace Observatory ───────
# Required for: remote evaluation, trace uploads to Confident AI
# Config file:  etc/confident/config.yaml
CONFIDENT_API_KEY=""

# DeepEval judge settings (local mode)
DEEPEVAL_OLLAMA_BASE_URL="http://localhost:11434"
DEEPEVAL_OLLAMA_MODEL="qwen2.5:7b"
DEEPEVAL_OLLAMA_TEMPERATURE="0"

# Version tag for prompt telemetry
DEEPEVAL_PROMPT_VERSION="2026-06-01"

# Enable flush-on-exit for Confident AI trace uploads
CONFIDENT_TRACE_FLUSH="1"

# Disable DeepEval telemetry
DEEPEVAL_TELEMETRY_OPT_OUT="1"

# ── Ollama ── Local LLM Inference (optional overrides) ──────────────────────
# Config file: etc/ollama/config.yaml
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_FLASH_ATTENTION=true
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_MAX_LOADED_MODELS=1

# ── HuggingFace Hub ── Base Model Config Downloads ─────────────────────────
# Required for: GGUF export (config.json download)
# Config file:  etc/huggingface/config.yaml
HF_TOKEN=""

# ── Modal ── Remote GPU (SCAFFOLDED — not active) ──────────────────────────
# Config file: etc/modal/config.yaml
# MODAL_TOKEN_ID=""
# MODAL_TOKEN_SECRET=""

# ── Other ──────────────────────────────────────────────────────────────────
# UCORE_WATCH=1                         # Enable CLI watch/logging mode
# UCORE_WATCH_DIR=/tmp/ucore-watch      # Watch output directory
